{
  "generatorOptions": {
    "pageName": "product-{slug}",
    "source": "products",
    "map": {
      "PRODUCT_NAME": "$data.name",
      "PRODUCT_PRICE": "$data.price",
      "PRODUCT_DESCRIPTION": "$data.description",
      "PRODUCT_DETAILS": "$data.details"
    }
  },
  "layout": {
    "name": "_layout",
    "vars": {
      "header_theme": "dark"
    }
  },
  "components": [
    {
      "name": "carousel",
      "vars": {
        "IMAGES": "$images",
        "ALT": "$data.name"
      }
    },
    {
      "name": "contactIcons"
    }
  ]
}
